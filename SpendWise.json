    {
      "parameters": {
        "operation": "aggregate",
        "collection": "={{ $json.jwtPayload.email }}",
        "query": "[\n  {\n    \"$addFields\": {\n      \"parsedDate\": {\n        \"$dateFromString\": { \"dateString\": \"$date\", \"format\": \"%Y-%m-%d\" }\n      }\n    }\n  },\n  {\n    \"$addFields\": {\n      \"weekOfMonth\": {\n        \"$ceil\": { \"$divide\": [{ \"$dayOfMonth\": \"$parsedDate\" }, 7] }\n      }\n    }\n  },\n  {\n    \"$group\": {\n      \"_id\": null,\n      \"totalIncome\": {\n        \"$sum\": {\n          \"$cond\": [\n            { \"$eq\": [\"$type\", \"income\"] },\n            { \"$toDouble\": \"$amount\" },\n            0\n          ]\n        }\n      },\n      \"totalExpense\": {\n        \"$sum\": {\n          \"$cond\": [\n            { \"$eq\": [\"$type\", \"expense\"] },\n            { \"$toDouble\": \"$amount\" },\n            0\n          ]\n        }\n      },\n      \"weeklyExpenses\": {\n        \"$push\": {\n          \"week\": \"$weekOfMonth\",\n          \"type\": \"$type\",\n          \"amount\": { \"$toDouble\": \"$amount\" }\n        }\n      }\n    }\n  },\n  {\n    \"$addFields\": {\n      \"netBalance\": { \"$subtract\": [\"$totalIncome\", \"$totalExpense\"] },\n      \"weeklyExpenseSummary\": {\n        \"$map\": {\n          \"input\": [1, 2, 3, 4],\n          \"as\": \"week\",\n          \"in\": {\n            \"week\": \"$$week\",\n            \"totalExpense\": {\n              \"$sum\": {\n                \"$map\": {\n                  \"input\": {\n                    \"$filter\": {\n                      \"input\": \"$weeklyExpenses\",\n                      \"as\": \"exp\",\n                      \"cond\": {\n                        \"$and\": [\n                          { \"$eq\": [\"$$exp.week\", \"$$week\"] },\n                          { \"$eq\": [\"$$exp.type\", \"expense\"] }\n                        ]\n                      }\n                    }\n                  },\n                  \"as\": \"e\",\n                  \"in\": \"$$e.amount\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  {\n    \"$addFields\": {\n      \"monthlyExpense\": {\n        \"$sum\": {\n          \"$map\": {\n            \"input\": \"$weeklyExpenseSummary\",\n            \"as\": \"weekData\",\n            \"in\": \"$$weekData.totalExpense\"\n          }\n        }\n      }\n    }\n  },\n  {\n    \"$project\": {\n      \"_id\": 0,\n      \"totalIncome\": 1,\n      \"totalExpense\": 1,\n      \"netBalance\": 1,\n      \"monthlyExpense\": 1,\n      \"weeklyExpenseSummary\": 1\n    }\n  }\n]"
